# ============================================================
# Visual search (Edge Function secrets) — reference only.
#
# These are Supabase secrets for the Edge Functions
# (index-product-image, reindex-catalog-images, visual-product-search),
# set via `supabase secrets set`. They do NOT belong in this project's
# Vite `.env` file and must never be prefixed with VITE_ — anything
# prefixed VITE_ is bundled into the browser build and would leak.
#
# See the deployment commands in the implementation report for the
# exact `supabase secrets set ...` invocation.
# ============================================================

OPENAI_API_KEY=
OPENAI_VISION_MODEL=
OPENAI_RERANK_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1536

VISUAL_SEARCH_GLOBAL_TOP_K=25
VISUAL_SEARCH_CATEGORY_TOP_K=15
VISUAL_SEARCH_GLOBAL_RERANK_K=8
VISUAL_SEARCH_CATEGORY_RERANK_K=6

VISUAL_SEARCH_EXACT_THRESHOLD=0.92
VISUAL_SEARCH_LIKELY_THRESHOLD=0.80
VISUAL_SEARCH_SIMILAR_THRESHOLD=0.62
VISUAL_SEARCH_CLOSE_RESULT_MARGIN=0.04
VISUAL_SEARCH_MAX_FILE_MB=8

# Optional
FUNCTION_SECRET=
IP_HASH_PEPPER=
VISUAL_SEARCH_DEBUG=false

# ============================================================
# NEW pixel-embedding visual search engine (image-against-image).
# Also Edge Function secrets, set via `supabase secrets set` — same rule as
# above: never prefix these with VITE_.
# ============================================================

# legacy | hybrid | visual — see the final report for what each mode does.
VISUAL_SEARCH_ENGINE=hybrid

# Private URL + shared secret for services/visual-search-inference. Never
# exposed to the browser.
VISUAL_INFERENCE_SERVICE_URL=
VISUAL_INFERENCE_API_KEY=

VISUAL_EMBEDDING_PROVIDER=dinov2
VISUAL_EMBEDDING_MODEL=facebook/dinov2-small
VISUAL_EMBEDDING_VERSION=v1
VISUAL_EMBEDDING_DIMENSIONS=384
VISUAL_PREPROCESSING_VERSION=v1

VISUAL_SEARCH_CATEGORY_RETRIEVAL_K=60
VISUAL_SEARCH_GLOBAL_RETRIEVAL_K=100
VISUAL_SEARCH_MIN_RAW_SIMILARITY=0.15

VISUAL_LOCAL_RERANK_ENABLED=true
VISUAL_LOCAL_RERANK_CANDIDATES=15

VISUAL_OCR_ENABLED=true

# OpenAI is disabled by default for the new pipeline — it is only ever used
# as a single, tightly-bounded ambiguity tie-break (spec section 18), never
# for indexing and never once per candidate.
VISUAL_SEARCH_OPENAI_ENABLED=false
VISUAL_SEARCH_OPENAI_RERANK_ENABLED=false
VISUAL_SEARCH_OPENAI_MAX_CANDIDATES=5
VISUAL_SEARCH_OPENAI_SCORE_MARGIN=0.04

VISUAL_SEARCH_CACHE_TTL_MINUTES=60

VISUAL_INDEX_BATCH_SIZE=10
VISUAL_INDEX_MAX_CONCURRENCY=2
VISUAL_INDEX_MAX_ATTEMPTS=4
VISUAL_INDEX_STALE_PROCESSING_MINUTES=5
