# Secrets/config for the visual-search-inference service. Set these on
# whatever host runs the Docker image (Fly.io/Render/Railway/a VPS/Cloud
# Run) — never commit a real .env.

# Shared secret the Edge Functions send as `X-Internal-Api-Key`. Generate
# with: openssl rand -hex 32
VISUAL_INTERNAL_API_KEY=

VISUAL_EMBEDDING_PROVIDER=dinov2
VISUAL_EMBEDDING_MODEL=facebook/dinov2-small
VISUAL_EMBEDDING_VERSION=v1
VISUAL_EMBEDDING_DIMENSIONS=384

VISUAL_PREPROCESSING_VERSION=v1
VISUAL_MAX_IMAGE_MB=8
VISUAL_NORMALIZED_IMAGE_SIZE=224

VISUAL_LOCAL_RERANK_ENABLED=true
VISUAL_LOCAL_RERANK_CANDIDATES=15

VISUAL_OCR_ENABLED=true
VISUAL_OCR_TIMEOUT_SECONDS=5.0

VISUAL_REQUEST_TIMEOUT_SECONDS=30.0
VISUAL_MAX_CONCURRENCY=2
VISUAL_MAX_BATCH_SIZE=16
VISUAL_RATE_LIMIT_MAX_REQUESTS=120
VISUAL_RATE_LIMIT_WINDOW_SECONDS=60.0

LOG_LEVEL=INFO
